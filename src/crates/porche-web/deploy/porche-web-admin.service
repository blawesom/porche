[Unit]
Description=PORCHE console-host — admin console (E-28; dry mode on the dev box)
Documentation=file:///home/outscale/git/porche/doc/design/12-software-architecture.md
After=network.target

[Service]
User=outscale
EnvironmentFile=/etc/porche-web/admin.env
ExecStart=/home/outscale/git/porche/src/target/release/porche-web \
    --dry \
    --base-path /porche/admin \
    --bind 127.0.0.1:18082 \
    --data-dir /home/outscale/porche-web \
    --store /home/outscale/porche-web/desired-state.sqlite3
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
