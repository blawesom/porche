# /etc/haproxy/haproxy.cfg — the PORCHE additions (2026-10-19)
# installed on dev.laplane.net; backup: haproxy.cfg.bak-20261019
#
# frontend https_in (before default_backend):
#     use_backend porche_user if { path /porche/user } || { path_beg /porche/user/ }
#     use_backend porche_admin if { path /porche/admin } || { path_beg /porche/admin/ }
#
# backends — pass-through, NO path rewrite: porche-web is base-path aware
# (it serves /porche/user/w and /porche/admin/a natively, links included)

backend porche_user
    http-request set-header X-Forwarded-Proto https
    http-request set-header X-Forwarded-Host dev.laplane.net
    server porche_user 127.0.0.1:18081 check

backend porche_admin
    http-request set-header X-Forwarded-Proto https
    http-request set-header X-Forwarded-Host dev.laplane.net
    server porche_admin 127.0.0.1:18082 check
