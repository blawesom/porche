# Guest kernel fragment — merged onto x86_64 defconfig (make defconfig +
# merge_config.sh). The guest surface is deliberately exactly what the PoC
# contract needs (guest/README.md): virtio-blk/net, IPv6, serial console,
# devtmpfs, ACPI poweroff. Nothing else is added on purpose (SEC-3 spirit).
#
# WS-C note: `make olddefconfig` may pull extra defaults from the base defconfig —
# the first on-node boot records `zcat /proc/config.gz` (if available) or the
# fragment-diff into the fixtures; tightening to a from-scratch minimalconfig is
# a post-PoC hardening step, not a PoC gate.

# virtio (the frozen device model — SEC-3)
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_MMIO=y

# network: IPv6-first workload addresses (E-22)
CONFIG_INET=y
CONFIG_IPV6=y

# serial console: the marker channel (PERF-1 T1)
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# initramfs rootfs + /dev
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# poweroff at workload exit (init.sh)
CONFIG_ACPI=y

# namespaces/cgroup info for the escape-delta exercises (SEC-11 class)
CONFIG_USER_NS=y
CONFIG_IO_URING=y

# keep it lean: no modules, no sound/usb/graphics/etc (defconfig defaults stand
# for the rest; the from-scratch minimal config is post-PoC)
CONFIG_MODULES=n
